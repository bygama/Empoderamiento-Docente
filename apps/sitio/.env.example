# .env.example — plantilla de variables de entorno
#
# Copiar a `.env.local` y completar. Los `.env*` reales están git-ignorados;
# este archivo SÍ se versiona. **Hoy el sitio no necesita ninguna**: son la
# infraestructura del admin, que llega en la fase 1.
#
# Decisión de fondo: docs/architecture/adrs/0005-admin-a-medida.md

# --- Base de datos (Postgres: Docker en local, Neon en Vercel) ---
# En local: postgresql://postgres:ed@localhost:5435/ed (ver README.md).
# En Vercel las escribe la integración de Neon.
DATABASE_URL=
# Conexión directa, sin pooler: el pooler corta las transacciones largas de
# una migración. En local puede ser la misma que DATABASE_URL o quedar vacía.
DATABASE_URL_UNPOOLED=

# --- Sitio ---
# URL pública del sitio, sin barra final. En producción https://empoderamientodocente.org
NEXT_PUBLIC_SITE_URL=

# --- Fotos (Vercel Blob) ---
# Con el token, las fotos que sube el admin van a Blob. Sin él (local), van a
# apps/sitio/.fotos/ (git-ignorada) y las sirve /api/fotos/<id>.
BLOB_READ_WRITE_TOKEN=

# --- CV (un store de Vercel Blob PRIVADO, otro que el de las fotos; ADR-0012) ---
# Con el token, los CV van al store privado; sin él, en local van a
# apps/sitio/.cv/ (git-ignorada) y en Vercel no se reciben. Solo del servidor.
CV_BLOB_READ_WRITE_TOKEN=
# El ajuste que enciende el formulario de CV del sitio: «si». Vacío, que es como
# viene, /sumate-al-equipo y /api/cv dan 404 (README, «Mensajes»).
CV_ABIERTO=

# --- Correos (Resend: «Elegí tu contraseña», «Tu contraseña cambió») ---
# Sin clave, fuera de producción, el correo sale entero por la consola del
# servidor (con el enlace): es lo que hace falta en local. En producción, sin
# clave el correo NO sale, y el log lo dice sin mostrar el enlace.
RESEND_API_KEY=
# Desde qué dirección salen, de un dominio verificado en Resend (README, «Correos»).
# Ej.: Empoderamiento Docente <no-responder@empoderamientodocente.org>
CORREO_REMITENTE=

# --- Admin (better-auth) ---
# Firma las sesiones. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# --- Métricas (la API de Web Analytics de Vercel; ver work/metricas/SPEC.md) ---
# Token de acceso de la cuenta de Vercel. ABRE TODA LA CUENTA: nunca
# NEXT_PUBLIC_, nunca en el navegador. Solo en Production y en tu .env.local.
VERCEL_TOKEN=
# El prj_… del proyecto del sitio (Project → Settings → General).
VERCEL_ANALYTICS_PROJECT_ID=
# Vacío en una cuenta personal; el team_… si el proyecto vive en un equipo.
VERCEL_TEAM_ID=
# Lo que el cron diario (/api/cron/diario) manda en Authorization; Vercel lo
# inyecta si existe. Sin él, el cron responde 401 a todo.
CRON_SECRET=

# --- Búsquedas (la API de Search Console; ver ADR-0011 y el README) ---
# De una cuenta de servicio de Google Cloud con la «Google Search Console API»
# habilitada, agregada como usuaria (permiso Restringido) de la propiedad.
# Solo del servidor: nunca NEXT_PUBLIC_. Sin las tres, Búsquedas dice que no
# está conectado y la copia no toca la API.
# El client_email del JSON de la cuenta de servicio.
SEARCH_CONSOLE_CLIENT_EMAIL=
# El private_key de ese JSON, entero y entre comillas; acepta los \n escritos.
SEARCH_CONSOLE_PRIVATE_KEY=
# La propiedad: sc-domain:empoderamientodocente.org (de dominio) o
# https://empoderamientodocente.org/ (de prefijo de URL).
SEARCH_CONSOLE_SITE_URL=
