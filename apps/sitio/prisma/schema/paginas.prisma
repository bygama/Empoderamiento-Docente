// El contenido editable de las páginas (work/edicion-de-paginas/SPEC.md §4).
// Un documento por página validado por el esquema de cada sección, y no una
// columna por texto: la estructura vive en código, la base guarda el
// documento. Es la divergencia más grande con el spec del admin (§12).

/// Una fila por página del sitio. Dos versiones del contenido: la que lee el
/// sitio y la que se está editando; cada publicación deja además su versión en
/// `versiones_de_paginas`. `publicado` en null significa «esta página todavía
/// muestra el contenido inicial del código»; `borrador` en null, «el borrador
/// es lo publicado».
model Pagina {
  slug         String    @id            // inicio | que-hacemos | …
  publicado    Json?                    // { seccion: contenido } validado
  publicadoEn  DateTime?
  publicadoPor String?                  // nombre de la cuenta, en llano
  borrador     Json?
  borradorEn   DateTime?
  borradorPor  String?

  versiones VersionDePagina[]

  @@map("paginas")
}

/// Cada publicación de una página: el documento que quedó en el sitio, quién y
/// cuándo (`work/paginas-inicio/SPEC.md` §3). Se guardan las últimas 10 por
/// página: publicar poda las más viejas en la misma transacción. «Restaurar
/// como borrador» lee de acá. Las columnas se llaman como las de `paginas`,
/// que es de donde salen.
model VersionDePagina {
  id           String   @id @default(uuid())
  slug         String
  pagina       Pagina   @relation(fields: [slug], references: [slug], onDelete: Cascade)
  documento    Json                   // el `publicado` que dejó esa publicación
  publicadoEn  DateTime @default(now())
  publicadoPor String                 // nombre de la cuenta, en llano

  @@index([slug, publicadoEn(sort: Desc)])
  @@map("versiones_de_paginas")
}

/// Una foto de la biblioteca (`work/casos-aliados-fotos/SPEC.md` §3): las que
/// se suben desde el admin y las del contenido que viven en `public/`, que
/// entraron con la migración `fotos_de_public`. El punto de foco NO va acá, y
/// el alt de acá es el de la foto, no el de cada lugar donde se usa: los dos
/// van con cada uso, porque la misma foto puede pedir otro recorte y otro alt
/// en otro marco. Los usos la encuentran por su `url` (`datos/fotos/`).
///
/// El id de una subida es el UUID que nombra su archivo (`/api/fotos/<id>` en
/// local, `fotos/<id>.<ext>` en Blob); una importada conserva su ruta de
/// `public/`.
model Foto {
  id        String   @id @default(uuid())
  /// Blob en Vercel; /api/fotos/<id> en local; /fotos/…, /aliados/… de public/.
  url       String   @unique
  /// Obligatorio al subir y al editar; vacío solo en una importada sin uso.
  alt       String
  ancho     Int
  alto      Int
  bytes     Int
  /// image/webp | image/jpeg | image/png; image/svg+xml solo en las
  /// importadas del repositorio (el logo de Techint): subir no lo acepta.
  tipo      String
  subidaEn  DateTime @default(now())
  /// Quién, en llano. Nulo en las que llegaron con el sitio.
  subidaPor String?

  @@map("fotos")
}
