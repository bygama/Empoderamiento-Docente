// Lo que se configura una vez y se edita en Ajustes (work/ajustes/SPEC.md §3 y
// §4). Antes vivía en el código (`config/site.ts`, `config/privacidad.ts`);
// ahora se cambia desde el admin sin un deploy.

/// Los datos institucionales del sitio: una fila sola, siempre (el `CHECK` de
/// la migración `datos_del_sitio`, que también la cargó con los de hoy). El
/// sitio la lee por `datos/consultas/sitio.ts` y la escribe Ajustes › Datos
/// del sitio. Lo de la marca —nombre, URL, descripción— sigue en el código.
model DatosDelSitio {
  id          Int       @id @default(1)
  correo      String
  /// Solo dígitos, con el código de país (56912345678): arma el link de
  /// WhatsApp. Sin número, no hay botón.
  whatsapp    String?
  calle       String
  /// El piso o la oficina.
  complemento String?
  ciudad      String
  region      String?
  pais        String
  /// Los países donde trabaja ED, en el orden en que se muestran.
  paises      String[]
  /// La URL de cada red. Sin URL, la red no aparece.
  instagram   String?
  facebook    String?
  linkedin    String?
  /// Null: como la cargó la migración.
  cambiadoEn  DateTime? @map("cambiado_en")
  /// El nombre de quien lo cambió, en llano, como `paginas.publicado_por`.
  cambiadoPor String?   @map("cambiado_por")

  @@map("datos_del_sitio")
}

/// Cada plazo de retención, con desde cuándo rige: una fila por cambio, y
/// nunca se edita una (work/ajustes/SPEC.md §4, ADR-0015). El historial es lo
/// que cumple la promesa: a lo que llegó se le aplica el menor entre el plazo
/// que regía al llegar y cualquiera posterior, así alargar no toca lo ya
/// recibido y acortar vale para todo (`config/privacidad.ts`). La migración
/// `plazos_de_retencion` cargó los tres de antes, vigentes desde siempre.
model PlazoDeRetencion {
  id        String   @id @default(uuid())
  /// cv | contacto (en meses) · spam (en días). Lista cerrada en código
  /// (`config/privacidad.ts`), no en un enum de Postgres.
  que       String
  valor     Int
  /// Desde cuándo rige. Los iniciales, desde el 1 de enero de 1970: siempre.
  desde     DateTime @default(now())
  /// El nombre de quien lo puso, en llano; null en los iniciales.
  puestoPor String?  @map("puesto_por")

  @@index([que, desde])
  @@map("plazos_de_retencion")
}