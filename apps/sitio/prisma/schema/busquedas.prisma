// La copia diaria de Search Console (ADR-0011, work/busquedas-de-google/).
// La llena una tarea del cron diario; el admin lee de acá y nunca de la API
// en el render.

/// Una fila por día, dimensión y valor. `valor` es "" en la fila del total.
/// Los días son los de Google, en hora del Pacífico.
///
/// `sumaDePosiciones` es la posición promedio que da Google por sus
/// impresiones: Google la promedia por impresión, así que un agregado de
/// varios días o filas se lee `Σ sumaDePosiciones / Σ impresiones`. Guardar
/// el promedio solo obligaría a promediar promedios, que da mal.
model BusquedaDiaria {
  fecha            DateTime @db.Date
  dimension        String   // total | consulta | pagina | pais
  valor            String   // "" · lo que se buscó · la URL · el país (ISO alfa-3)
  clics            Int
  impresiones      Int
  sumaDePosiciones Float

  @@id([fecha, dimension, valor])
  @@map("busquedas_diarias")
}

/// Si cada ruta del sitemap está en Google, según la API de inspección de URL
/// de Search Console (work/ajustes/SPEC.md §5.3). La llena una tarea del cron
/// diario, que borra las filas de las rutas que ya no están; Ajustes › SEO lee
/// de acá, nunca de la API en el render.
model IndexacionDeUrl {
  /// La ruta, como en el sitemap: "/que-hacemos".
  ruta          String    @id
  /// El de Google, tal cual: PASS | PARTIAL | FAIL | NEUTRAL | VERDICT_UNSPECIFIED.
  veredicto     String
  /// El `coverageState` de Google, tal cual y en inglés («Submitted and
  /// indexed»): la pantalla lo traduce.
  cobertura     String
  /// Cuándo pasó Google por última vez; null si nunca.
  ultimoRastreo DateTime? @map("ultimo_rastreo")
  revisadaEn    DateTime  @map("revisada_en")

  @@map("indexacion_de_urls")
}
