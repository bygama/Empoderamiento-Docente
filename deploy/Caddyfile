# El único servicio que sale a internet (compose.yaml). Certificado
# automático: de Let's Encrypt con un dominio de verdad, y de la CA interna de
# Caddy con `localhost`, para la prueba local.
{
	email {$CORREO_ACME}
	servers {
		# Quién puede decir cuál es la IP de quien pide. Sin Cloudflare, nadie:
		# 127.0.0.1 no le habla nunca al proxy, y vale la de la conexión. Con
		# Cloudflare (compose.cloudflare.yaml), la red interna, por donde entra
		# el túnel con la IP en CF-Connecting-IP.
		trusted_proxies static {$PROXIES_DE_CONFIANZA:127.0.0.1/32}
		client_ip_headers Cf-Connecting-Ip
	}
}

# La IP de quien pide, `{client_ip}`: la de la conexión, o la que trae el
# túnel. La app, better-auth y Umami leen solo X-Real-IP (ADR-0019), y se pisa
# con ese valor. X-Forwarded-For también, con el mismo único valor: encadenado,
# deja adelante lo que haya mandado el cliente, y nada de adentro tiene que
# poder leerlo así. Confían en estas cabeceras porque nadie más que Caddy les
# habla (ADR-0018).
(ip-real) {
	header_up X-Real-IP {client_ip}
	header_up X-Forwarded-For {client_ip}
	# La ubicación de una sesión sale de estas en Vercel
	# (packages/auth/src/ubicacion.ts). Acá no hay Vercel: si llegan, las mandó
	# el cliente.
	header_up -X-Vercel-*
}

# www. lleva al dominio con el mismo camino. El DNS de www suele ser un CNAME
# al dominio; sin este bloque, Caddy no tendría certificado para www y el
# navegador mostraría un error de TLS.
{$ESQUEMA:}www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Con Cloudflare, ESQUEMA es "http://" (compose.cloudflare.yaml): TLS termina
# allá y el túnel llega por HTTP. Sin él, vacío: Caddy saca el certificado.
{$ESQUEMA:}{$DOMINIO} {
	encode zstd gzip

	# Cada pedido, en JSON por la salida del contenedor (Docker la rota: el
	# daemon.json del VPS, docs/deploy/vps.md). La IP va enmascarada, como en
	# las visitas, y sin cookies ni credenciales: sirve para ver un ataque o un
	# error, no para seguir a una persona.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	# Sin rastro del servidor en las respuestas.
	header {
		-Server
		-Via
		defer
	}

	# El cron llama a la app por la red interna (deploy/cron/correr.mjs):
	# desde afuera, esa ruta no existe. TRACE no lo usa nada.
	handle /api/cron/* {
		respond 404
	}
	@trace method TRACE
	handle @trace {
		respond 405
	}

	# Umami (servicio `analitica`): el script que carga el sitio y el pedido
	# que manda cada vista, y nada más. Su panel, su login y su API no salen a
	# internet: se usan por un túnel SSH (docs/deploy/vps.md).
	@umami path /umami/script.js /umami/api/send
	handle @umami {
		uri strip_prefix /umami
		reverse_proxy analitica:3000 {
			import ip-real
		}
	}
	handle /umami/* {
		respond 404
	}

	# Todo lo demás es el sitio y su admin.
	handle {
		reverse_proxy app:3000 {
			import ip-real
		}
	}
}
