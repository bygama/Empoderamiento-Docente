# El único servicio que sale a internet (compose.yaml). Certificado
# automático: de Let's Encrypt con un dominio de verdad, y de la CA interna de
# Caddy con `localhost`, para la prueba local.
{
	email {$CORREO_ACME}
}

# La IP de quien pide. Caddy ignora el X-Forwarded-For que manda un cliente
# (no hay `trusted_proxies`: no hay nada delante) y pone la de la conexión.
# X-Real-IP, en cambio, pasaría tal cual, y la app la lee como segunda opción
# (lib/formularios/limite.ts, better-auth): se pisa también. La app y Umami
# confían en estas cabeceras porque nadie más que Caddy les habla (ADR-0018).
# Si algún día va un CDN delante, sus rangos van en `trusted_proxies`.
(ip-real) {
	header_up X-Real-IP {remote_host}
}

# www. lleva al dominio con el mismo camino. El DNS de www suele ser un CNAME
# al dominio; sin este bloque, Caddy no tendría certificado para www y el
# navegador mostraría un error de TLS.
www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

{$DOMINIO} {
	encode zstd gzip

	# Umami (servicio `analitica`): el script que carga el sitio y el pedido
	# que manda cada vista, y nada más. Su panel, su login y su API no salen a
	# internet: se usan por un túnel SSH (docs/deploy/vps.md).
	@umami path /umami/script.js /umami/api/send
	handle @umami {
		uri strip_prefix /umami
		reverse_proxy analitica:3000 {
			import ip-real
		}
	}
	handle /umami/* {
		respond 404
	}

	# Todo lo demás es el sitio y su admin.
	handle {
		reverse_proxy app:3000 {
			import ip-real
		}
	}
}
