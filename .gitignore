# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (per-developer local state)
.claude/settings.local.json

# oh-my-claudecode (per-developer local state)
.omc/

# superpowers (per-developer local state)
.superpowers/
docs/superpowers/

# playwright mcp (local screenshots / console artifacts)
.playwright-mcp/

# fotos subidas al panel cuando no hay Vercel Blob (desarrollo)
fotos-local/

# next dev escribe un bloque `nextjs-agent-rules` dentro de la app, en un
# AGENTS.md y un CLAUDE.md propios, cada vez que levanta (lo genera
# node_modules/next/dist/server/lib/generate-agent-files.js). El contrato de
# este repo vive en los .md de la raíz —la golden rule de AGENTS.md §3—, así
# que esa copia generada no se versiona: dos AGENTS.md es justo lo que esa
# regla existe para evitar.
/apps/*/AGENTS.md
/apps/*/CLAUDE.md
