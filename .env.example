# .env.example — plantilla de variables de entorno
#
# Copiar a `.env.local` y completar. Los `.env*` reales están git-ignorados;
# este archivo SÍ se versiona. Sin panel (solo el sitio) no hace falta ninguna.
#
# Decisión de fondo: docs/architecture/adrs/0003-adoptar-neon-y-payload.md

# --- Base de datos (Postgres: Docker en local, Neon en Vercel) ---
# En local: postgresql://postgres:ed@localhost:5435/ed_panel (ver docs/README.md).
# En Vercel las escribe la integración de Neon.
DATABASE_URL=
# Conexión directa (sin pooler). La usa `payload migrate`; en local puede ser
# la misma que DATABASE_URL o quedar vacía.
DATABASE_URL_UNPOOLED=

# --- Payload ---
# Firma las sesiones. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Protege la ruta /vista-previa (modo borrador). Generar igual que arriba.
VISTA_PREVIA_SECRET=
# URL pública del sitio, sin barra final. En producción https://empoderamientodocente.org
NEXT_PUBLIC_SITE_URL=

# --- Fotos (Vercel Blob). Sin token, las fotos se guardan en ./fotos-local ---
BLOB_READ_WRITE_TOKEN=

# --- Correos del panel (Resend). Sin clave, los correos salen por consola ---
RESEND_API_KEY=
