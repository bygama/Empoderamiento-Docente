# El .env del compose (compose.yaml, docs/deploy/vps.md). En el servidor:
# `cp .env.example .env`, completarlo y `chmod 600 .env`. Nunca se commitea con
# valores (.gitignore lo deja afuera). Para correr el sitio sin Docker, las
# variables son otras: apps/sitio/.env.example.

# El dominio, sin https:// (en la prueba local: localhost).
DOMINIO=
# A quién le escribe Let's Encrypt por los certificados.
CORREO_ACME=

# Las claves de Postgres, una por usuario. En hexadecimal, porque viajan
# adentro de una URL: `openssl rand -hex 24`.
CLAVE_DB_ADMIN=
CLAVE_DB_ED=
CLAVE_DB_UMAMI=

# El sitio (qué es cada una: apps/sitio/.env.example).
# `openssl rand -base64 32` para los dos secretos.
BETTER_AUTH_SECRET=
CRON_SECRET=
RESEND_API_KEY=
CORREO_REMITENTE=
CV_ABIERTO=
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
SEARCH_CONSOLE_SITE_URL=

# Umami (servicio `analitica`). El secreto, con `openssl rand -hex 32`. La
# API key y el sitio se crean en su panel después del primer deploy
# (docs/deploy/vps.md, «Umami»), y hace falta un deploy más para que el sitio
# cargue el script.
UMAMI_APP_SECRET=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# Los respaldos diarios (servicio `respaldo`): cuántos días se guardan y de
# quién son en el host (el usuario del deploy, para copiarlos afuera sin sudo;
# `id -u` y `id -g`).
DIAS_DE_RESPALDO=14
DUENO_DE_RESPALDOS=1000:1000

# Vercel Blob, solo si se quiere: vacías, las fotos y los CV van a sus
# volúmenes del VPS.
BLOB_READ_WRITE_TOKEN=
CV_BLOB_READ_WRITE_TOKEN=

# Cloudflare adelante, por Cloudflare Tunnel (docs/deploy/vps.md §15): el
# token del túnel, y el compose con su capa. Sin estas tres, el VPS publica el
# 80 y el 443 y Caddy saca su certificado.
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_FILE=compose.yaml:compose.cloudflare.yaml
# COMPOSE_PATH_SEPARATOR=:
