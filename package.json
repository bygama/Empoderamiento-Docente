{
  "name": "empoderamiento-docente",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --fail-if-no-match --filter sitio dev",
    "build": "pnpm --fail-if-no-match --filter sitio build",
    "start": "pnpm --fail-if-no-match --filter sitio start",
    "lint": "pnpm --fail-if-no-match -r lint",
    "typecheck": "pnpm --fail-if-no-match -r typecheck",
    "react-doctor": "pnpm dlx react-doctor --no-supply-chain --project apps/sitio/src,packages/db/src,packages/auth/src",
    "prisma": "node scripts/guarda-prisma.mjs",
    "migrate": "node scripts/guarda-prisma.mjs migrate dev",
    "migrate:deploy": "node scripts/guarda-prisma.mjs migrate deploy",
    "migrate:status": "node scripts/guarda-prisma.mjs migrate status",
    "generate": "node scripts/guarda-prisma.mjs generate",
    "prepare": "node scripts/instalar-hooks.mjs"
  }
}
