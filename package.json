{
  "name": "empoderamiento-docente",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter sitio dev",
    "build": "pnpm --filter sitio build",
    "start": "pnpm --filter sitio start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "react-doctor": "pnpm dlx react-doctor --no-supply-chain src",
    "prepare": "node scripts/instalar-hooks.mjs"
  }
}
