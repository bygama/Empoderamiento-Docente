#!/bin/sh
# ---------------------------------------------------------------------------
# pre-push — el gate del repo. Ahora SÍ frena.
#
# Hasta el 2026-09-08 este hook solo avisaba, porque el repo arrastraba deuda
# de React que no se arreglaba en un push. Esa deuda es cero: react-doctor da
# 100/100 sin diagnosticos, y la regla es no volver atras (AGENTS.md §5.8).
#
# Corre tres cosas, de la mas barata a la mas cara (~10s en total):
#   typecheck (~1s) · react-doctor (~3s) · lint (~6s)
# Y antes, un chequeo instantaneo: que los .sh de scripts/ y deploy/ lleven el
# bit de ejecucion en git (el runbook del VPS los corre directo).
# El build NO va aca: es de CI, tarda demasiado para un push.
#
# Corre TODAS aunque una falle, asi ves la lista completa de una y no vas
# descubriendo problemas de a uno.
#
# Para saltearlo hay una sola puerta, la de git: `git push --no-verify`.
# Queda en el reflog y se ve. A proposito no hay variable de entorno propia:
# eso es lo que convierte un gate en decoracion.
# ---------------------------------------------------------------------------
set -u

fallo=0

titulo() {
  printf '\n\033[1m> %s\033[0m\n' "$1"
}

titulo 'scripts ejecutables'
# docs/deploy/vps.md manda a correr `scripts/desplegar.sh` y los demas tal
# cual: sin el bit (100755) en el indice, en Ubuntu contestan «Permission
# denied». En Windows git no lo pone solo (core.fileMode=false), asi que un .sh
# nuevo entra sin el: `git update-index --chmod=+x <archivo>`. El pathspec
# `*.sh` de git cruza carpetas, asi que cubre deploy/db/ y deploy/respaldo/.
sin_bit=$(git ls-files -s -- 'scripts/*.sh' 'deploy/*.sh' | grep -v '^100755' || true)
if [ -n "$sin_bit" ]; then
  printf '%s\n' "$sin_bit" | cut -f2 | sed 's/^/  sin el bit de ejecucion: /'
  fallo=1
else
  echo '  todos con el bit'
fi

titulo 'typecheck'
if ! pnpm typecheck; then fallo=1; fi

titulo 'react-doctor'
if ! node scripts/verificar-react-doctor.mjs; then fallo=1; fi

titulo 'lint'
if ! pnpm lint; then fallo=1; fi

if [ "$fallo" != 0 ]; then
  printf '\n\033[31m\033[1m  Push frenado.\033[0m Arreglá lo de arriba y volvé a empujar.\n'
  printf '\033[2m  Si de verdad tenés que pasar por encima: git push --no-verify\033[0m\n\n'
  exit 1
fi

printf '\n\033[32m  Todo en verde.\033[0m\n\n'
exit 0
